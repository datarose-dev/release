{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datarose-dev/release/blob/master/release.schema.json",
  "title": "Datarose release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["units"],
  "properties": {
    "$schema": { "type": "string" },
    "baseBranch": { "type": "string", "default": "master" },
    "releaseAuthor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?(?:\\[bot\\])?$",
      "default": "github-actions[bot]",
      "description": "Exact authenticated GitHub PR author login. Set explicitly for a PAT or GitHub App; no wildcard or arbitrary-bot matching."
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$", "not": { "enum": ["constructor", "prototype", "__proto__"] } },
      "additionalProperties": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "scheme": { "enum": ["calver", "semver"], "default": "calver" },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Explicit relative directories, or '.'. Overlapping units are rejected." },
        "tagPrefix": { "type": "string", "default": "v" },
        "initialVersion": { "type": "string", "default": "0.1.0", "description": "Stable canonical SemVer used for the first SemVer release." },
        "changelog": { "oneOf": [{ "type": "string", "minLength": 1 }, { "const": false }], "default": "CHANGELOG.md" },
        "githubRelease": { "type": "boolean", "default": true },
        "draft": { "type": "boolean", "default": false },
        "prerelease": { "type": "boolean", "default": false },
        "manifests": { "type": "array", "default": [], "items": { "$ref": "#/$defs/manifest" } }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "key"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["json", "yaml", "toml"] },
        "key": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "not": { "enum": ["constructor", "prototype", "__proto__"] } } }
      }
    }
  }
}
